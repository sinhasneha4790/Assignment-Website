# Copy to .env.local and fill in. Never commit real values.
# In Vercel, set these per environment (Production / Preview / Development).

# Database — Neon via the Vercel Marketplace integration sets these automatically
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# SMS OTP (MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments (Razorpay) — test keys until the owner approves go-live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Images (Cloudinary, or Vercel Blob)
CLOUDINARY_URL=
BLOB_READ_WRITE_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron route protection
CRON_SECRET=

# Errors
SENTRY_DSN=

# Set to true for one deploy to load the sample catalogue, then remove it
SEED_ON_DEPLOY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# GST invoices (production)
GSTIN=
BUSINESS_ADDRESS=
